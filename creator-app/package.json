{
  "name": "openclasscraft-creator",
  "version": "0.1.0",
  "description": "A visual creator for safe OpenClassCraft classroom mods.",
  "main": "main.js",
  "scripts": { "start": "electron .", "package:win": "electron-builder --win portable" },
  "build": { "appId": "org.openclasscraft.creator", "productName": "OpenClassCraft Creator", "files": ["**/*", "!dist/**"], "win": { "target": ["portable"] } },
  "dependencies": { "blockly": "^12.2.1" },
  "devDependencies": { "electron": "^37.2.6", "electron-builder": "^26.0.12" }
}
